---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
interface Props { title?: string; }
const { title = "Alejandro Franco" } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content="Alejandro Franco" />
    <meta property="og:description" content="stats & data science, building." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://xtwothree.net" />
    <meta property="og:image" content="https://xtwothree.net/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Alejandro Franco" />
    <meta name="twitter:description" content="stats & data science, building." />
    <meta name="twitter:image" content="https://xtwothree.net/og-image.png" />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">

    <!-- ── header ── -->
    <header style="display:flex;align-items:flex-start;padding:1.25rem 2.5rem 1rem 1.5rem;">

      <!-- identity / back -->
      <div style="flex:1;">
        {path !== '/' && <a href="/" class="back-link">← back</a>}
      </div>

      <nav style="display:flex;gap:2rem;padding-top:0.15rem;">
        <a href="/projects" class="nav-link">projects</a>
        <a href="/blog"     class="nav-link">blog</a>
      </nav>

      <div style="flex:1;display:flex;justify-content:flex-end;">
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
          <span id="theme-icon">○</span>
        </button>
      </div>
    </header>

    <script is:inline>
      const root = document.documentElement;
      const saved = localStorage.getItem('theme');
      if (saved === 'light') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', 'dark');

      function updateIcon() {
        const icon = document.getElementById('theme-icon');
        if (icon) icon.textContent = root.getAttribute('data-theme') === 'dark' ? '●' : '○';
      }
      updateIcon();

      document.addEventListener('astro:before-swap', (e) => {
        if (localStorage.getItem('theme') !== 'light')
          e.newDocument.documentElement.setAttribute('data-theme', 'dark');
      });

      document.addEventListener('astro:page-load', () => {
        updateIcon();
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;

        btn.addEventListener('click', async () => {
          const dark = root.getAttribute('data-theme') === 'dark';

          if (!document.startViewTransition) {
            root.setAttribute('data-theme', dark ? '' : 'dark');
            localStorage.setItem('theme', dark ? 'light' : 'dark');
            updateIcon();
            return;
          }

          const btnEl = document.getElementById('theme-toggle');
          const rect = btnEl.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const maxR = Math.hypot(Math.max(cx, window.innerWidth - cx), Math.max(cy, window.innerHeight - cy));

          root.dataset.vt = 'theme';
          const transition = document.startViewTransition(() => {
            root.setAttribute('data-theme', dark ? '' : 'dark');
            localStorage.setItem('theme', dark ? 'light' : 'dark');
            updateIcon();
          });

          try {
            await transition.ready;
            document.documentElement.animate(
              { clipPath: [`circle(0px at ${cx}px ${cy}px)`, `circle(${maxR}px at ${cx}px ${cy}px)`] },
              { duration: 600, easing: 'cubic-bezier(0.4,0,0.2,1)', pseudoElement: '::view-transition-new(root)' }
            );
            await transition.finished;
          } finally {
            delete root.dataset.vt;
          }
        });
      });
    </script>

    <!-- ── page content ── -->
    <slot />

    <!-- ── footer ── -->
    <footer style="width:100%;display:flex;flex-direction:column;align-items:center;gap:0.65rem;padding:3.5rem 1rem 2.5rem;">
      <div style="display:flex;gap:1.75rem;">
        <a href="https://github.com/xtwothree"                   target="_blank" rel="noopener noreferrer" class="footer-link">github</a>
        <a href="https://www.linkedin.com/in/4lejandrofranco/"   target="_blank" rel="noopener noreferrer" class="footer-link">linkedin</a>
        <a href="https://steamcommunity.com/id/xtwohree/"        target="_blank" rel="noopener noreferrer" class="footer-link">steam</a>
      </div>
      <p style="font-family:var(--font-mono);font-size:0.62rem;color:#b0b0b0;">
        site built with astro &amp; tailwind
      </p>
    </footer>

  </body>
</html>
