---
import '../styles/global.css';
interface Props { title?: string; }
const { title = "Alejandro Franco" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Lora:ital,wght@0,400;0,500;1,400&family=Space+Mono&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">

    <nav class="w-full flex justify-center gap-8 pt-10 pb-6">
      <a href="/projects" class="nav-link">projects</a>
      <a href="/blog"     class="nav-link">blog</a>
    </nav>

    <slot />

  </body>
</html>
