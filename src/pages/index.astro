---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <main style="max-width:680px; margin-left:clamp(3rem,10vw,8rem); padding:0 2rem; flex:1;">
    <section class="pt-24 md:pt-32 pb-24 md:pb-32">

      <p
        class="hero-item"
        style="font-family:var(--font-body);font-size:clamp(1.25rem,2.6vw,1.5rem);line-height:1.6;color:#4a4a48;animation-delay:0.1s;"
      >
        Greetings, I'm Alejandro — a rookie in the tech space, looking
        to put my developing skills toward projects worth building.
      </p>

      <p
        class="hero-item"
        style="font-family:var(--font-body);font-size:clamp(1.25rem,2.6vw,1.5rem);line-height:1.6;color:#4a4a48;margin-top:1.4rem;animation-delay:0.2s;"
      >
        This summer, I'm interning as a <a href="https://apple.com" target="_blank" rel="noopener noreferrer" class="role-link" style="color:#252523;">Machine Learning Engineer @ Apple</a>, team is TBD.
      </p>

      <p
        class="hero-item"
        style="font-family:var(--font-body);font-size:clamp(1.25rem,2.6vw,1.5rem);line-height:1.6;color:#4a4a48;margin-top:1.4rem;animation-delay:0.3s;"
      >
        Outside of my digital presence, I'm trying my hardest to perfect my
        sleep schedule, lifting, or looking for ways to improve my life —
        one percent at a time.
      </p>

    </section>
  </main>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
    );
    document.querySelectorAll('.sr').forEach((el) => observer.observe(el));
  </script>

</Layout>
