        <div class="menu">
          <button class="menu-item scene-btn" data-target="now"  data-label="now">
            <span class="menu-label">now</span>
            <span class="menu-arrow">→</span>
          </button>
          <button class="menu-item scene-btn" data-target="next" data-label="next">
            <span class="menu-label">next</span>
            <span class="menu-arrow">→</span>
          </button>
          <button class="menu-item scene-btn" data-target="life" data-label="life">
            <span class="menu-label">life</span>
            <span class="menu-arrow">→</span>
          </button>
          <button class="menu-item scene-btn" data-target="edu"  data-label="edu">
            <span class="menu-label">edu</span>
            <span class="menu-arrow">→</span>
          </button>
        </div>
      </div>

      <!-- ── shared detail nav ── -->
      <div class="detail-nav">
        <button class="detail-nav-btn scene-btn" data-target="overview">←</button>
        <span class="detail-nav-sep">·</span>
        <button class="detail-nav-btn scene-btn" data-target="now">now</button>
        <span class="detail-nav-sep">·</span>
        <button class="detail-nav-btn scene-btn" data-target="next">next</button>
        <span class="detail-nav-sep">·</span>
        <button class="detail-nav-btn scene-btn" data-target="life">life</button>
        <span class="detail-nav-sep">·</span>
        <button class="detail-nav-btn scene-btn" data-target="edu">edu</button>
      </div>

      <!-- ── now ── -->
      <div class="about-scene" data-scene="now">
        <div class="detail-rows">
          <span class="detail-key">co</span>
          <span class="detail-sep">──</span>
          <span class="detail-val"><a href="https://apple.com" target="_blank" rel="noopener noreferrer" class="role-link">apple</a></span>

          <span class="detail-key">role</span>
