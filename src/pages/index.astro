---
import '../styles/global.css';

const name = "Alejandro Franco";

const links = [
  { label: "GitHub",      href: "https://github.com/xtwothree",          note: "xtwothree" },
  { label: "Twitter / X", href: "https://twitter.com/xtwothree",          note: "xtwothree" },
  { label: "LinkedIn",    href: "https://linkedin.com/in/yourusername",   note: "in/you"    },
  { label: "Email",       href: "mailto:afrancojc@gmail.com",             note: "↗"         },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{name}</title>
    <meta name="description" content="Personal site of Alejandro Franco." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;500;600;700&family=Lora:ital,wght@0,400;0,500;1,400&family=Space+Mono&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen">

    <div class="max-w-[600px] mx-auto px-6">

      <!-- ── nav ── -->
      <header class="hero-item flex items-center justify-between pt-10 pb-2" style="animation-delay:0s;">
        <span style="font-family:var(--font-display);font-size:0.85rem;font-weight:600;letter-spacing:-0.01em;color:var(--color-text);">
          Alejandro Franco
        </span>
        <span style="font-family:var(--font-mono);font-size:0.65rem;color:var(--color-muted);">
          xtwothree
        </span>
      </header>

      <!-- ── bio ── -->
      <section class="pt-20 pb-16 md:pt-28 md:pb-20">

        <p
          class="hero-item"
          style="
            font-family: var(--font-body);
            font-size: clamp(1.15rem, 2.5vw, 1.3rem);
            line-height: 1.8;
            color: var(--color-text);
            animation-delay: 0.1s;
          "
        >
          Greetings, I'm Alejandro&thinsp;<span style="font-family:var(--font-mono);font-size:0.9em;">^_^</span>&thinsp;new
          to the tech space, hoping to tackle curious findings and putting them
          into play with soon-to-come projects.
        </p>

        <p
          class="hero-item"
          style="
            font-family: var(--font-body);
            font-size: clamp(1.15rem, 2.5vw, 1.3rem);
            line-height: 1.8;
            color: var(--color-text);
            margin-top: 1.4rem;
            animation-delay: 0.2s;
          "
        >
          Currently, I'm heading to Apple as a Data Science intern — team is TBD.
        </p>

        <p
          class="hero-item"
          style="
            font-family: var(--font-body);
            font-size: clamp(1.15rem, 2.5vw, 1.3rem);
            line-height: 1.8;
            color: #777;
            margin-top: 1.4rem;
            animation-delay: 0.3s;
          "
        >
          Outside of my digital presence, I'm trying my hardest to perfect my
          sleep schedule, lifting, or looking for ways to improve my life —
          one percent at a time.
        </p>

      </section>

      <!-- ── rule ── -->
      <hr style="border:none;border-top:1px solid var(--color-border);margin:0;" />

      <!-- ── links ── -->
      <section class="py-14">

        <p class="sr" style="font-family:var(--font-display);font-size:0.68rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:var(--color-muted);margin-bottom:0.75rem;">
          Elsewhere
        </p>

        <ul>
          {links.map((link, i) => (
            <li class={`sr delay-${i + 1}`}>
              <a
                href={link.href}
                class="link-row"
                target={link.href.startsWith('mailto') ? undefined : '_blank'}
                rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
              >
                <span style="font-family:var(--font-display);font-size:0.95rem;font-weight:500;">
                  {link.label}
                </span>
                <span class="ext">{link.note !== '↗' ? link.note : '↗'}</span>
              </a>
            </li>
          ))}
        </ul>

      </section>

      <!-- ── footer ── -->
      <hr style="border:none;border-top:1px solid var(--color-border);" />
      <footer class="py-8">
        <p style="font-family:var(--font-mono);font-size:0.62rem;color:#ccc;">
          &copy; {new Date().getFullYear()} {name}
        </p>
      </footer>

    </div>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
      );
      document.querySelectorAll('.sr').forEach((el) => observer.observe(el));
    </script>

  </body>
</html>
