---
import Layout from '../layouts/Layout.astro';

const links = [
  { label: "github",   href: "https://github.com/xtwothree"                },
  { label: "linkedin", href: "https://www.linkedin.com/in/4lejandrofranco/" },
  { label: "steam",    href: "https://steamcommunity.com/id/xtwohree/"      },
];
---

<Layout>

  <main style="max-width:680px; padding:0 2rem 0 clamp(1.5rem,7vw,6rem); flex:1;">
    <section class="pt-16 md:pt-20 pb-24 md:pb-32">

      <p
        class="hero-item"
        style="font-family:var(--font-body);font-size:clamp(1.25rem,2.6vw,1.5rem);line-height:1.85;color:#4a4a48;animation-delay:0.1s;"
      >
        Greetings, I'm Alejandro — a rookie in the tech space, looking
        to put my developing skills toward projects worth building.
      </p>

      <p
        class="hero-item"
        style="font-family:var(--font-body);font-size:clamp(1.25rem,2.6vw,1.5rem);line-height:1.85;color:#4a4a48;margin-top:1.4rem;animation-delay:0.2s;"
      >
        This summer, I'm interning as a <a href="https://apple.com" target="_blank" rel="noopener noreferrer" class="role-link" style="color:#252523;">Machine Learning Engineer @ Apple</a>, team is TBD.
      </p>

      <p
        class="hero-item"
        style="font-family:var(--font-body);font-size:clamp(1.25rem,2.6vw,1.5rem);line-height:1.85;color:#4a4a48;margin-top:1.4rem;animation-delay:0.3s;"
      >
        Outside of my digital presence, I'm trying my hardest to perfect my
        sleep schedule, lifting, or looking for ways to improve my life —
        one percent at a time.
      </p>

    </section>
  </main>

  <footer class="sr w-full flex flex-col items-center gap-3 pb-10 pt-4">
    <div style="display:flex;gap:1.75rem;">
      {links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          {link.label}
        </a>
      ))}
    </div>
    <p style="font-family:var(--font-mono);font-size:0.62rem;color:#b0b0b0;">
      site built with astro &amp; tailwind
    </p>
    <p style="font-family:var(--font-mono);font-size:0.58rem;color:#c0c0c0;">
      design inspiration:&nbsp;<a href="https://patrickyoussef.com" target="_blank" rel="noopener noreferrer" style="color:#aaa;text-decoration:underline;text-underline-offset:3px;">patrickyoussef.com</a>
    </p>
  </footer>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
    );
    document.querySelectorAll('.sr').forEach((el) => observer.observe(el));
  </script>

</Layout>
