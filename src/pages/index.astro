---
import '../styles/global.css';

const name = "Alejandro Franco";

const links = [
  { label: "github",   href: "https://github.com/xtwothree"                  },
  { label: "linkedin", href: "https://www.linkedin.com/in/4lejandrofranco/"   },
  { label: "email",    href: "mailto:afrancojc@gmail.com"                     },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{name}</title>
    <meta name="description" content="Personal site of Alejandro Franco." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Lora:ital,wght@0,400;0,500;1,400&family=Space+Mono&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen">

    <div style="max-width:640px; padding: 0 1.5rem 0 clamp(1.5rem, 8vw, 7rem);">

      <!-- ── name ── -->
      <header class="hero-item pt-14 md:pt-20 pb-12 md:pb-16" style="animation-delay:0s;">
        <span style="font-family:'Syne',sans-serif;font-size:clamp(1.3rem,3vw,1.6rem);font-weight:800;letter-spacing:-0.02em;color:var(--color-text);">
          {name}
        </span>
      </header>

      <!-- ── bio ── -->
      <section class="pb-24 md:pb-32">

        <p
          class="hero-item"
          style="font-family:var(--font-body);font-size:clamp(1.2rem,2.6vw,1.42rem);line-height:1.82;color:var(--color-text);animation-delay:0.1s;"
        >
          Greetings, I'm Alejandro&thinsp;<span style="font-family:var(--font-mono);font-size:0.85em;color:#aaa;">^_^</span>&thinsp;new
          to the tech space, hoping to tackle curious findings and putting them
          into play with soon-to-come projects.
        </p>

        <p
          class="hero-item"
          style="font-family:var(--font-body);font-size:clamp(1.2rem,2.6vw,1.42rem);line-height:1.82;color:var(--color-text);margin-top:1.5rem;animation-delay:0.2s;"
        >
          Currently, I'm heading to Apple as a Data Science intern — team is TBD.
        </p>

        <p
          class="hero-item"
          style="font-family:var(--font-body);font-size:clamp(1.2rem,2.6vw,1.42rem);line-height:1.82;color:#888;margin-top:1.5rem;animation-delay:0.3s;"
        >
          Outside of my digital presence, I'm trying my hardest to perfect my
          sleep schedule, lifting, or looking for ways to improve my life —
          one percent at a time.
        </p>

      </section>

      <!-- ── footer links ── -->
      <footer class="sr pb-12">
        <div style="display:flex;gap:1.6rem;margin-bottom:1rem;">
          {links.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith('mailto') ? undefined : '_blank'}
              rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
              style="font-family:var(--font-mono);font-size:0.7rem;color:var(--color-muted);text-decoration:none;transition:color 0.15s ease;"
              onmouseover="this.style.color='#1a1a1a'"
              onmouseout="this.style.color='var(--color-muted)'"
            >
              {link.label}
            </a>
          ))}
        </div>
        <p style="font-family:var(--font-mono);font-size:0.65rem;color:#ccc;">
          site built with astro &amp; tailwind &middot; &copy; {new Date().getFullYear()}
        </p>
      </footer>

    </div>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
      );
      document.querySelectorAll('.sr').forEach((el) => observer.observe(el));
    </script>

  </body>
</html>
