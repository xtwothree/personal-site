          </span>

          <span class="detail-key">team</span>
          <span class="detail-sep">──</span>
          <span class="detail-val"><a href="https://www.apple.com/iphone/?afid=p240%7Cgo~cmp-14645102856~adg-126654827229~ad-799623051072_kwd-334361787~dev-c~ext-~prd-~mca-~nt-search&cid=wwa-us-kwgo-iphone-core-iphonefamily-iphone_hero_avail_031126-iPhone_Core_Exact-iPhone_Exact" target="_blank" rel="noopener noreferrer" class="role-link">worldwide sales finance · iphone</a></span>

          <span class="detail-key">focus</span>
          <span class="detail-sep">──</span>
          <span class="detail-val">workflow &amp; automation</span>
        </div>
      </div>

      <!-- ── next ── -->
      <div class="about-scene" data-scene="next">
        <div class="detail-rows">
          <span class="detail-key">co</span>
          <span class="detail-sep">──</span>
          <span class="detail-val"><a href="https://apple.com" target="_blank" rel="noopener noreferrer" class="role-link">apple</a></span>

          <span class="detail-key">role</span>
          <span class="detail-sep">──</span>
          <span class="detail-val detail-val-split">
            <span>machine learning engineer intern</span>
            <span class="detail-loc">austin, tx · summer 2027</span>
          </span>

          <span class="detail-key">note</span>
          <span class="detail-sep">──</span>
          <span class="detail-val">more to build. more to prove.</span>
        </div>
      </div>

      <!-- ── edu ── -->
      <div class="about-scene" data-scene="edu">
        <div class="detail-rows">
          <span class="detail-key">school</span>
          <span class="detail-sep">──</span>
          <span class="detail-val"><a href="https://www.ucsb.edu" target="_blank" rel="noopener noreferrer" class="role-link">University of California, Santa Barbara</a></span>

          <span class="detail-key">study</span>
          <span class="detail-sep">──</span>
          <span class="detail-val">B.S. Statistics &amp; Data Science</span>

          <span class="detail-key">focus</span>
          <span class="detail-sep">──</span>
