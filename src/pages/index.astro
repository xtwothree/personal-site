          <span class="detail-val">optimizing consistency</span>

          <span class="detail-key">lift</span>
          <span class="detail-sep">──</span>
          <span class="detail-val">building the foundation</span>

          <span class="detail-key">growth</span>
          <span class="detail-sep">──</span>
          <span class="detail-val">1% better every day</span>

          <span class="detail-key">games</span>
          <span class="detail-sep">──</span>
          <span class="detail-val">valorant · stardew valley · expedition 33</span>

          <span class="detail-key">music</span>
          <span class="detail-sep">──</span>
          <span class="detail-val">baby jane · glokk40spaz · marchpane</span>
        </div>
      </div>

    </div>
  </main>
</Layout>

<script>
  const GLYPHS = '#!%&@*/\\?><~^';

  function startIdleGlitch(el: HTMLElement, target: string): () => void {
    let timer: ReturnType<typeof setTimeout>;
    function schedule() {
      timer = setTimeout(() => {
        const i = Math.floor(Math.random() * target.length);
        el.textContent = target.substring(0, i) + GLYPHS[Math.floor(Math.random() * GLYPHS.length)] + target.substring(i + 1);
        setTimeout(() => { el.textContent = target; schedule(); }, 110);
      }, 700 + Math.random() * 1100);
    }
    schedule();
    return () => clearTimeout(timer);
  }

  function scrambleTo(el: HTMLElement, target: string) {
    const frames = 22;
    const resolveAt = Array.from({ length: target.length }, () => Math.floor(Math.random() * frames));
    let frame = 0;
    function tick() {
      let out = '';
      let done = 0;
      for (let i = 0; i < target.length; i++) {
        if (frame >= resolveAt[i]) { out += target[i]; done++; }
        else out += GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
      }
      el.textContent = out;
      if (done < target.length) { frame++; requestAnimationFrame(tick); }
    }
    requestAnimationFrame(tick);
  }

  function initCard() {
    const card = document.querySelector('.about-card');
    if (!card) return;

    // ── scene switching ──
    const detailNav = card.querySelector<HTMLElement>('.detail-nav');
    card.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLElement>('.scene-btn');
      if (!btn) return;
      const target = btn.dataset.target;
      if (!target) return;
      if (target !== 'overview') {
        (card as HTMLElement).style.minHeight = card.getBoundingClientRect().height + 'px';
        if (detailNav) {
          detailNav.style.display = 'flex';
          detailNav.querySelectorAll<HTMLElement>('.detail-nav-btn').forEach(b => {
            b.classList.toggle('active', b.dataset.target === target);
          });
        }
      } else {
        (card as HTMLElement).style.minHeight = '';
        if (detailNav) detailNav.style.display = 'none';
      }
      card.querySelectorAll<HTMLElement>('.about-scene').forEach(s => s.classList.remove('active'));
      card.querySelector<HTMLElement>(`[data-scene="${target}"]`)?.classList.add('active');
    });

    // ── glitch labels ──
    card.querySelectorAll<HTMLElement>('.menu-item').forEach(item => {
      const labelEl = item.querySelector<HTMLElement>('.menu-label');
      const target = item.dataset.label;
      if (!labelEl || !target) return;

      let stopIdle = startIdleGlitch(labelEl, target);

      item.addEventListener('mouseenter', () => {
        stopIdle();
        scrambleTo(labelEl, target);
      });

      item.addEventListener('mouseleave', () => {
        labelEl.textContent = target;
        stopIdle = startIdleGlitch(labelEl, target);
      });
    });
  }

  document.addEventListener('astro:page-load', initCard);
</script>

<style>
  .about-card {
    border: 1px solid var(--color-border);
    padding: 3.25rem 3.75rem;
    max-width: 640px;
    width: calc(100% - 3rem);
    opacity: 0;
    animation: fadeUp 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  .site-handle {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin: 0 0 1.25rem;
    opacity: 0;
    animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* ── scenes ── */
  .about-scene { display: none; }
  .about-scene.active {
    display: block;
    animation: sceneFade 0.18s ease forwards;
  }
  @keyframes sceneFade {
    from { opacity: 0; transform: translateY(5px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── overview ── */
  .about-bio {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text);
    line-height: 1.75;
    margin: 0;
    text-align: justify;
    text-align-last: left;
  }
  .menu {
    margin-top: 1.5rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--color-border);
  }
  .menu-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 0.85rem 0;
    border: none;
    border-bottom: 1px solid var(--color-border);
    background: none;
    cursor: pointer;
  }
  .menu-item:last-child { border-bottom: none; }
  .menu-label {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-text);
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }
  .menu-arrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    transition: transform 0.2s ease, color 0.15s ease;
  }
  .menu-item:hover .menu-arrow {
    transform: translateX(5px);
    color: var(--color-text);
  }

  /* ── detail nav ── */
  .detail-nav {
    display: none;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0;
  }
  .detail-nav-btn {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .detail-nav-btn:hover,
  .detail-nav-btn.active { color: var(--color-text); }
  .detail-nav-sep {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-border);
    pointer-events: none;
  }
  .detail-rows {
    display: grid;
    grid-template-columns: 3.4rem 1.4rem 1fr;
    row-gap: 0.55rem;
    align-items: baseline;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .detail-key {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
  }
  .detail-sep {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-border);
  }
  .detail-val {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text);
    line-height: 1.55;
  }
  .detail-val-split {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }
  .detail-loc {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .about-card { padding: 1.75rem; }
  }
</style>
