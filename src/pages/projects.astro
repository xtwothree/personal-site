---
import Layout from '../layouts/Layout.astro';

const sections = [
  {
    label: 'projects',
    items: [
      {
        slug: 'personal-site',
        name: 'personal site',
        desc: 'minimal portfolio with glitch ui and interactive scene cards',
        tech: 'astro · tailwind · typescript',
        year: 'May 2026',
        ghost: false,
      },
      {
        name: 'untitled',
        desc: null,
        tech: null,
        year: null,
        ghost: true,
      },
    ],
  },
];
---

<Layout title="projects — Alejandro Franco">
  <main class="flex-1 flex flex-col items-center justify-center pb-20">
    <div class="projects-wrap sr visible">

      {sections.map(section => (
        <div class="projects-section">
          <div class="projects-list">
            {section.items.map(p => (
              p.ghost ? (
                <div class="project-entry project-entry-ghost">
                  <div class="project-row">
                    <span class="project-name">[ untitled ]</span>
                    <span class="project-year">coming soon</span>
                  </div>
                  <p class="project-desc">something's brewing</p>
                </div>
              ) : (
                <a href={`/projects/${p.slug}`} class="project-entry project-entry-link">
                  <div class="project-row">
                    <span class="project-name">{p.name}</span>
                    <span class="project-year">{p.year}</span>
                  </div>
                  <p class="project-tech">{p.tech}</p>
                  {p.desc && <p class="project-desc">{p.desc}</p>}
                </a>
              )
            ))}
          </div>
        </div>
      ))}

    </div>
  </main>
</Layout>

<style>
  .projects-wrap {
    max-width: 580px;
    width: calc(100% - 3rem);
  }

  .projects-section {
    margin-bottom: 2.5rem;
  }

  .projects-list {
    border-top: 1px solid var(--color-border);
  }

  .project-entry {
    display: block;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
  }

  .project-entry-link {
    transition: opacity 0.15s ease;
  }
  .project-entry-link:hover { opacity: 0.7; }

  .project-entry-ghost {
    opacity: 0.35;
  }

  .project-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .project-name {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text);
  }

  .project-year {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .project-tech {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-muted);
    margin: 0.3rem 0 0;
    opacity: 0.7;
  }

  .project-desc {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-muted);
    margin: 0.2rem 0 0;
    opacity: 0.7;
  }

  @media (max-width: 480px) {
    .project-row { flex-direction: column; gap: 0.2rem; }
  }
</style>
